# Supabase (Project Settings > API Keys). Projeto na região São Paulo (sa-east-1).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Só no servidor. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Endereço público do app (usado nos convites por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Apenas para o seed de demonstração (npm run seed:demo)
DEMO_PASSWORD=
DEMO_EMAIL_DOMAIN=demo.nexoprojetosdesign.com.br
SEED_SUPERADMIN_EMAIL=
